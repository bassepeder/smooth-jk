{
  "manifest_version": 2,
  "name": "Smooth Keyscroll",
  "version": "1.2.0",
  "author": "bassepeder",
  "description": "Vimari-style smooth keyboard scrolling with rebindable keys, meant to run alongside Vimium.",
  "browser_specific_settings": {
    "gecko": {
      "id": "smooth-keyscroll@bassepeder",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
